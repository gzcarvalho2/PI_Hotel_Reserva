generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Reserva {
  reserva_id       Int      @id @default(autoincrement())
  reserva_checkin  DateTime
  reserva_checkout DateTime
  reserva_status   Int
  cliente_id       Int?
  quarto_id        Int?
  status_pagamento Int?
  tipo_quarto_id   Int

  @@index([cliente_id])
  @@index([quarto_id])
  @@index([reserva_checkin, reserva_checkout])
}
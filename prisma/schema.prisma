generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model reserva {
  reserva_id       Int      @id @default(autoincrement())
  reserva_checkin  DateTime @db.DateTime(0)
  reserva_checkout DateTime @db.DateTime(0)
  reserva_status   Int
  cliente_id       Int
  quarto_id        Int?
  pagamento_status Int?
  tipo_quarto_id   Int
}

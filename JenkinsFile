pipeline {

    agent any

    stages {

        stage('Fetch Secrets') {
            steps {
                sh 'npx -y @infisical/cli export --env="dev" --path="/pedidos" --token="st.333517ed-deea-40e5-b7e2-e030a662a2b6.988191099ff97d2ecd98b11e35f9f3cd.8a112389d0edbeab052e034c6fdbe73c" > .env'
            }
        }

        stage('Install Dependencies') {

            steps {

                sh 'npm install'
            }
        }

        stage('Prisma Generate') {

            steps {

                sh 'npx prisma generate'
            }
        }

        stage('Docker Build') {

            steps {

                sh 'docker compose build'
            }
        }

        stage('Docker Up') {

            steps {

                sh 'docker compose up -d'
            }
        }

        stage('Docker PS') {

            steps {

                sh 'node -v'
                sh 'npm -v'
            }
        }
    }

    post {

        success {

            echo 'Pipeline executada com sucesso!'
        }

        failure {

            echo 'Erro na pipeline!'
        }
    }
}

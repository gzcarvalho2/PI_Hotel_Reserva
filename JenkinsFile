pipeline {

    agent any

    stages {

        stage('Fetch Secrets') {
            steps {
                sh 'npx -y @infisical/cli export --env="dev" --path="/reserva" --token="st.4b539ca4-50f7-4edb-a932-86047d6ab1a2.0caa1140598679790043d46a09e07e89.92b4a8d2d98d6a1e9247a0fb0aff39e6" > .env'
            }
        }

        stage('Install Dependencies') {

            steps {

                sh 'npm install'
            }
        }

        stage('Prisma Generate') {

            steps {

                sh 'npx prisma generate'
            }
        }

        stage('Docker Build') {

            steps {

                sh 'docker compose build'
            }
        }

        stage('Docker Up') {

            steps {

                sh 'docker compose up -d'
            }
        }

        stage('Docker PS') {

            steps {

                sh 'node -v'
                sh 'npm -v'
            }
        }
    }

    post {

        success {

            echo 'Pipeline executada com sucesso!'
        }

        failure {

            echo 'Erro na pipeline!'
        }
    }
}
